# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
# Set to true for local production smoke tests and the trusted App Runner proxy.
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS (local development only: App Runner uses its instance role instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB (use local endpoint for development)
DYNAMODB_ENDPOINT=http://localhost:8000

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Model routing: simple Point & Ask is kept cheap; structured coverage can use
# a stronger model when it is enabled in the selected AWS region.
BEDROCK_ASK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_COVERAGE_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Safety controls for model-backed asks.
ASK_DAILY_LIMIT=20
SPATIAL_DAILY_LIMIT=20
COVERAGE_DAILY_LIMIT=10
ASK_IDEMPOTENCY_TTL_SECONDS=86400

# Opt-in cited public-web Research Mode. Keep Bedrock disabled until its
# Mantle/Web Search entitlement and API key are configured; Gemini is the demo fallback.
RESEARCH_DAILY_LIMIT=5
RESEARCH_PROVIDER_TIMEOUT_MS=30000
RESEARCH_BEDROCK_FAILURE_THRESHOLD=3
RESEARCH_BEDROCK_COOLDOWN_MS=30000
BEDROCK_WEB_SEARCH_ENABLED=false
BEDROCK_WEB_SEARCH_REGION=us-east-1
BEDROCK_WEB_SEARCH_MODEL=openai.gpt-5.6-terra
BEDROCK_MANTLE_API_KEY=
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# Comma-separated exact email allowlist for platform-wide Master Admin access.
# Do not infer this role from a domain or OAuth provider claim.
MASTER_ADMIN_EMAILS=owner@example.com

# Extension
EXTENSION_PAIRING_EXPIRY_MINUTES=10
EXTENSION_TOKEN_EXPIRY_DAYS=30
