# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
# Set to true for local production smoke tests and the trusted App Runner proxy.
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS (local development only: App Runner uses its instance role instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB (use local endpoint for development)
DYNAMODB_ENDPOINT=http://localhost:8000

# Live AI provider. This key is server-only; never expose it to the browser or extension.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_FAILURE_THRESHOLD=3
GEMINI_COOLDOWN_MS=30000

# Safety controls for model-backed asks.
ASK_DAILY_LIMIT=20
SPATIAL_DAILY_LIMIT=20
COVERAGE_DAILY_LIMIT=10
ASK_IDEMPOTENCY_TTL_SECONDS=86400

# Opt-in cited public-web Research Mode. Gemini Google Search is the live provider.
# Bedrock is intentionally disabled pending AWS account verification.
RESEARCH_DAILY_LIMIT=5
RESEARCH_PROVIDER_TIMEOUT_MS=30000
RESEARCH_BEDROCK_FAILURE_THRESHOLD=3
RESEARCH_BEDROCK_COOLDOWN_MS=30000
BEDROCK_WEB_SEARCH_ENABLED=false
BEDROCK_WEB_SEARCH_REGION=us-east-1
BEDROCK_WEB_SEARCH_MODEL=openai.gpt-5.6-terra
BEDROCK_MANTLE_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-3.6-flash

# Comma-separated exact email allowlist for platform-wide Master Admin access.
# Do not infer this role from a domain or OAuth provider claim.
MASTER_ADMIN_EMAILS=owner@example.com

# Extension
EXTENSION_PAIRING_EXPIRY_MINUTES=10
EXTENSION_TOKEN_EXPIRY_DAYS=30
